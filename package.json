{
  "name": "app-store-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for app store scraping functionality",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPatterns=integration --runInBand --detectOpenHandles",
    "test:integration:docker": "docker compose -f docker/docker-compose.integration.yml run --rm --build live-check",
    "test:integration:local": "NODE_ENV=test npm run test:integration",
    "lint": "eslint src scripts tools examples",
    "clean": "rm -rf dist",
    "generate-ssl": "./scripts/generate-ssl-certs.sh",
    "test:live": "npm run build && node scripts/live-check.js"
  },
  "keywords": [
    "mcp",
    "app-store",
    "scraper",
    "typescript",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "app-store-scraper-ts": "^0.5.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "google-play-scraper-ts": "^0.5.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/eventsource": "^1.1.15",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.14",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^10.14.0",
    "eventsource": "^2.0.2",
    "jest": "^30.0.4",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
